    "        continue\n",
    "        \n",
    "    if market_symbol not in commods['Close'].columns:\n",
    "        print(f\"  ❌ Symbol {market_symbol} not in commods data\")\n",
    "        continue\n",
    "    \n",
    "    # Get the raw data for this symbol\n",
    "    raw_close = commods['Close'][market_symbol]\n",
    "    print(f\"  Raw data: {len(raw_close)} rows, {raw_close.notna().sum()} valid\")\n",
    "    \n",
    "    # Create simple DataFrame - no fancy operations\n",
    "    market_data = pd.DataFrame({\n",
    "        'Date': raw_close.index,\n",
    "        'Close': raw_close.values,\n",
    "        'Market': market_name,\n",
    "        'YF_Symbol': market_symbol\n",
    "    })\n",
    "    \n",
    "    # Add other price columns one by one (with debugging)\n",
    "    for price_col in ['Open', 'High', 'Low', 'Volume']:\n",
    "        if price_col in commods.columns and market_symbol in commods[price_col].columns:\n",
    "            raw_data = commods[price_col][market_symbol]\n",
    "            market_data[price_col] = raw_data.values\n",
    "            print(f\"  Added {price_col}: {raw_data.notna().sum()} valid values\")\n",
    "        else:\n",
    "            print(f\"  ⚠ {price_col} not available\")\n",
    "    \n",
    "    print(f\"  Final DataFrame: {len(market_data)} rows\")\n",
    "    daily_prices.append(market_data)\n",
    "\n",
    "print(f\"\\nCombining {len(daily_prices)} market datasets...\")\n",
    "daily_price_df = pd.concat(daily_prices, ignore_index=True)\n",
    "\n",
    "print(f\"Combined dataset: {len(daily_price_df)} total rows\")\n",
    "\n",
    "# Check specific markets\n",
    "for test_market in ['CORN - CHICAGO BOARD OF TRADE', 'SOYBEANS - CHICAGO BOARD OF TRADE']:\n",
